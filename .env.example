# Server
PORT=3333
NODE_ENV=development

# Database (Supabase PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Auth / Client
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Admin Secret (para criação de Super Admin)
ADMIN_SECRET="super-admin-secret-change-me"

# Groq Cloud AI (Whisper Large v3 & Llama 3.3)
GROQ_API_KEY="gsk_your_groq_api_key_here"
# URL base compatível com OpenAI (pode ser trocada para https://api.openai.com/v1 em produção se desejar)
GROQ_BASE_URL="https://api.groq.com/openai/v1"
# Modelos padrão (customizáveis caso a Groq atualize ou deprecie IDs na sua conta)
GROQ_CHAT_MODEL="llama-3.3-70b-versatile"
GROQ_AUDIO_MODEL="whisper-large-v3"
